# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Every file under assets/ is loaded by index.html with a ?v=N pin, and every poster with ?<look>: a new version is a
# new address, so the browser may keep these for good instead of asking the server again on each visit.
# index.html itself is NOT listed: it keeps the default (always re-checked), so a new version is seen at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/brand/posters/*
  Cache-Control: public, max-age=31536000, immutable
